# install.sh generates runtime/stack.env; no shared default passwords.
ANTIGRAVITY_PORT=8045
WORKBUDDY_PORT=7863
SUB2API_PORT=8080
AISTUDIO_PORT=2048
QODER_PORT=8790
ANTIGRAVITY_IMAGE=lbjlaq/antigravity-manager:v5.0.3
WORKBUDDY_IMAGE=ghcr.io/linguo2625469/workbuddy2api-panel:1.13.0
SUB2API_IMAGE=weishaw/sub2api:0.2.23
AISTUDIO_IMAGE=ghcr.io/mag1cfall/aistudio2api:latest
QODER_IMAGE=ghcr.io/shuishuipingan/qoder2api-hub:latest
ANTIGRAVITY_API_KEY=
ANTIGRAVITY_WEB_PASSWORD=
WORKBUDDY_API_KEY=
AISTUDIO_API_KEY=
AISTUDIO_ADMIN_USER=admin
AISTUDIO_ADMIN_PASSWORD=
QODER_API_KEY=
QODER_PANEL_PASSWORD=
AISTUDIO_CHANNELS=playground
SUB2API_EMAIL=admin@sub2api.local
SUB2API_PASSWORD=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
TOTP_ENCRYPTION_KEY=
# Optional outbound proxy, reachable from containers (not their 127.0.0.1).
UPSTREAM_PROXY=
