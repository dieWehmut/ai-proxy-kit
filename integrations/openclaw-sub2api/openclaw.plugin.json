{
  "id": "sub2api-auto",
  "name": "Sub2API Group Model Sync",
  "description": "Use the current API key group model for each Sub2API agent turn.",
  "version": "0.1.0",
  "providers": ["sub2api"],
  "activation": { "onStartup": true },
  "setup": { "providers": [{ "id": "sub2api", "envVars": ["SUB2API_API_KEY"] }] },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "baseUrl": { "type": "string" },
      "keyEnv": { "type": "string", "default": "SUB2API_API_KEY" },
      "statePath": { "type": "string" },
      "configPath": { "type": "string" },
      "refreshIntervalMs": { "type": "integer", "minimum": 1000, "default": 15000 },
      "timeoutMs": { "type": "integer", "minimum": 100, "default": 4000 }
    }
  }
}
